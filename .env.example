# Copy to .env.local for development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# Google Business Profile (primary + optional locations)
GOOGLE_MY_BUSINESS_ACCESS_TOKEN=
GOOGLE_MY_BUSINESS_LOCATION_ID=
GOOGLE_MY_BUSINESS_ACCOUNT_ID=
GOOGLE_SHARJAH_LOCATION_ID=
GOOGLE_SHARJAH_ACCOUNT_ID=
GOOGLE_SILICON_LOCATION_ID=
GOOGLE_SILICON_ACCOUNT_ID=
GOOGLE_ABUDHABI_LOCATION_ID=
GOOGLE_ABUDHABI_ACCOUNT_ID=
GOOGLE_ARJAN_LOCATION_ID=
GOOGLE_ARJAN_ACCOUNT_ID=

# Optional: OAuth refresh for long-lived Google tokens
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Seasonal order/notify emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SEASONAL_ORDERS_EMAIL=
SEASONAL_NOTIFY_EMAIL=
